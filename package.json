{
  "name": "syncclipboard-cf-server",
  "version": "1.25.2",
  "private": true,
  "license": "MIT",
  "description": "SyncClipboard 官方服务器的 Cloudflare Workers 复刻版（TypeScript），协议兼容官方客户端",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "dev:web": "node web/build.mjs --watch",
    "build:web": "node web/build.mjs",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "lint": "eslint test/manual",
    "check": "npm run typecheck && npm run lint",
    "test": "vitest run --no-file-parallelism",
    "test:watch": "vitest"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "hono": "^4.6.0",
    "mrmime": "^2.0.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260915.1",
    "@microsoft/signalr": "^8.0.7",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.12",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "typescript": "^5.6.0",
    "undici": "^8.10.2",
    "vitest": "^2.1.0",
    "wrangler": "^4.131.2"
  }
}
